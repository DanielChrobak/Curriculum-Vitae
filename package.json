{
  "name": "curriculum-vitae",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Daniel Chrobak's professional portfolio and curriculum vitae.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "refresh:github": "node scripts/refresh-github.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
